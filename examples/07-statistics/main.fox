fn main() {
    let values = [3, 1, 4, 1, 5, 9, 2, 6];
    var sum = 0;
    var minimum = values[0];
    var maximum = values[0];
    var i = 0;
    while i < len(values) {
        let value = values[i];
        sum = sum + value;
        if value < minimum {
            minimum = value;
        }
        if value > maximum {
            maximum = value;
        }
        i = i + 1;
    }
    print(sum);
    print(minimum);
    print(maximum);
    print(sum / len(values));
}
