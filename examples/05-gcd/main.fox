fn gcd(a: int, b: int) -> int {
    var x = a;
    var y = b;
    while y != 0 {
        let remainder = x % y;
        x = y;
        y = remainder;
    }
    return x;
}

fn main() {
    print(gcd(48, 18));
    print(gcd(54, 24));
    print(gcd(17, 13));
}

test "gcd required examples" {
    assert_eq(gcd(48, 18), 6);
    assert_eq(gcd(54, 24), 6);
    assert_eq(gcd(17, 13), 1);
}

test "gcd zero equality and order" {
    assert_eq(gcd(0, 0), 0);
    assert_eq(gcd(9, 0), 9);
    assert_eq(gcd(0, 9), 9);
    assert_eq(gcd(7, 7), 7);
    assert_eq(gcd(18, 48), 6);
    assert_eq(gcd(9223372036854775807, 1), 1);
}
