fn classify(n: int) {
    if n < 0 {
        print("negative");
    } else if n == 0 {
        print("zero");
    } else {
        print("positive");
    }
    if n % 2 == 0 {
        print("even");
    } else {
        print("odd");
    }
}

fn main() {
    classify(-7);
    classify(0);
    classify(8);
}
